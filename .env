# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# MinIO (local S3 — maps to Azure ADLS Gen2 in production)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=http://localhost:9000

# Producer
TRANSACTIONS_PER_MINUTE=60

# Buckets
BRONZE_BUCKET=za-payments-bronze
SILVER_BUCKET=za-payments-silver
GOLD_BUCKET=za-payments-gold
